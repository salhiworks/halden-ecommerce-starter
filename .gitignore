# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/tests/.artifacts

# next.js
/.next/
/out/

# production
/build

# local-mode store data: products, orders, uploads and the owner account.
# Never commit it — it holds customer details once real orders arrive.
/.data/
# copies `npm run demo:reset` keeps of the store it replaced
/.data-backups/

# your private list for `npm run privacy:check` (hashes of details that must
# never ship, such as a former client's name or phone number)
/.privacy/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Supabase CLI working files (the linked project, caches)
/supabase/.temp/
/supabase/.branches/

# env files — only the template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
