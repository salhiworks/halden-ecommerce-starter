# The three settings your store needs — all from your Supabase project.
#
# `npm run setup` fills them in for you, in a file called .env.local.
# On Hostinger, add these same three names under Environment variables.
# Everything else (store name, currency, WhatsApp number, checkout…) is set
# in your store's dashboard, not here.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Advanced options exist but are not needed: see docs/advanced-configuration.md
