# -----------------------------------------------------------------------------
# Environment variables
#
# `npm run setup` writes the Supabase values to `.env.local` for you. To do it
# by hand, copy this file to `.env.local`. On Hostinger, add the same names
# under your Node.js app → Environment variables. Never commit real values:
# `.env*` files other than this template are ignored by git.
#
# None of these is NEXT_PUBLIC_, so no value is ever sent to a browser.
# Store details (name, WhatsApp number, currency, delivery…) are NOT here:
# the owner sets them in the dashboard.
# -----------------------------------------------------------------------------

# --- Where the data lives -----------------------------------------------------
# Leave the three Supabase values empty to run on the local backend: a JSON
# file and an uploads folder in .data/. Zero setup, good for trying things.
# Use Supabase for a live store, so a redeploy never touches your data.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API keys → "Publishable key" (or the legacy "anon" key)
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API keys → "Secret key" (or the legacy "service_role" key).
# Used only on the server, to save shoppers' orders and show them their order
# page. Required for checkout on Supabase. Treat it like a password.
SUPABASE_SECRET_KEY=

# Optional. Force a backend: local | supabase. By default, Supabase is used
# whenever SUPABASE_URL is set.
STORE_BACKEND=


# --- Security -----------------------------------------------------------------
# Signs checkout form tokens and local dashboard sessions. 32+ random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If left empty, one is derived from the Supabase secret key, or created in .data/.
SESSION_SECRET=

# Local backend in production only: the one-time code /admin/setup asks for
# before it creates the owner account. Not needed with Supabase.
ADMIN_SETUP_TOKEN=


# --- Optional -----------------------------------------------------------------
# Folder for the local backend's data (default: ./.data). On a server, put it
# outside the app folder so a redeploy does not replace it.
STORE_DATA_DIR=

# How many seconds the shop reuses a loaded catalog before asking the
# database again (default 30). Saving in the dashboard refreshes it at once.
CATALOG_CACHE_SECONDS=

# Only for a public demo of your store (like the hosted Halden demo): visitors
# can open a read-only preview of the dashboard, and orders placed in the shop
# are kept in memory for an hour instead of being saved. Never on a real store.
PUBLIC_DEMO_MODE=
